# ============================================================
# .env.example — Environment variable template for PipelineDoc
# ============================================================
#
# HOW TO USE:
#   1. Copy this file to .env:
#        cp .env.example .env
#
#   2. Replace the placeholder values with your real values
#
#   3. NEVER commit .env to git — it contains secrets!
#      (.env is already in .gitignore, so git will ignore it)
#
# ============================================================

# Your Anthropic API key
# Get one at: https://console.anthropic.com/
# It looks like: sk-ant-api03-...
ANTHROPIC_API_KEY=your-anthropic-api-key-here
