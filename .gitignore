# ============================================================
# PipelineDoc .gitignore
# ============================================================
# This file tells git which files to NEVER track or commit.
# Lines starting with # are comments.
# NOTE: git does NOT support inline comments — # must be on its own line.

# ------------------------------------------------------------
# SECRETS — never commit these
# ------------------------------------------------------------
.env
*.pem
*.key
secrets.json

# ------------------------------------------------------------
# Python build artifacts
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# ------------------------------------------------------------
# Virtual environments
# ------------------------------------------------------------
.venv/
venv/
env/
ENV/
.virtualenv/

# ------------------------------------------------------------
# Testing & coverage
# ------------------------------------------------------------
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/

# ------------------------------------------------------------
# IDEs and editors
# ------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ------------------------------------------------------------
# Generated output — we keep the folder but not the contents
# ------------------------------------------------------------
# The .gitkeep file in output/ tracks the empty folder.
# Generated .md and .html files are regenerated on every run,
# so we don't commit them (they'd create noisy diffs).
output/*.md
output/*.html

# However, keep the .gitkeep so the folder exists in the repo:
!output/.gitkeep
